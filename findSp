DECLARE @ProcedureName SYSNAME = 'YourProcedureName';

CREATE TABLE #Results
(
    DatabaseName   SYSNAME,
    SchemaName     SYSNAME,
    ProcedureName SYSNAME
);

DECLARE @Command NVARCHAR(MAX);

SET @Command = N'
IF DB_ID(''?'') > 4
AND DATABASEPROPERTYEX(''?'', ''Status'') = ''ONLINE''
BEGIN
    INSERT INTO #Results
    SELECT
        ''?'',
        SCHEMA_NAME(schema_id),
        name
    FROM [?].sys.procedures
    WHERE name = ''' + REPLACE(@ProcedureName, '''', '''''') + N'''
END';

EXEC master.dbo.sp_MSforeachdb @Command;

SELECT
    DatabaseName,
    SchemaName,
    ProcedureName
FROM #Results
ORDER BY DatabaseName, SchemaName;

DROP TABLE #Results;
