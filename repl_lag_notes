rs.conf().members.map(m => ({
    host: m.host,
    votes: m.votes,
    priority: m.priority,
    hidden: m.hidden,
    secondaryDelaySecs: m.secondaryDelaySecs,
    arbiterOnly: m.arbiterOnly
}))

