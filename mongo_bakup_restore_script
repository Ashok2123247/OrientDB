
#!/bin/bash

# MongoDB Backup and Restore Automation
# Requirements: Bash, MongoDB Database Tools (mongodump/mongorestore)

set -o pipefail
umask 077

BACKUP_DIR="/var/backups/mongodb"
LOG_DIR="/var/log/mongodb-backup"

mkdir -p "$BACKUP_DIR" "$LOG_DIR" || exit 1

START_TIME=$(date +%s)
RUN_ID=$(date '+%Y%m%d_%H%M%S')
LOG_FILE="${LOG_DIR}/mongo_backup_restore_${RUN_ID}.log"

# Send all console output to the screen and log file.
exec > >(tee -a "$LOG_FILE") 2>&1

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

elapsed_time() {
    local total=$(( $(date +%s) - START_TIME ))
    printf '%02d:%02d:%02d' \
        "$((total / 3600))" \
        "$(((total % 3600) / 60))" \
        "$((total % 60))"
}

finish() {
    local rc=$?
    trap - EXIT
    log "=================================================="
    if (( rc == 0 )); then
        log "FINAL STATUS : SUCCESS"
    else
        log "FINAL STATUS : FAILED (exit code: $rc)"
    fi
    log "TOTAL DURATION: $(elapsed_time) (HH:MM:SS)"
    log "LOG FILE      : $LOG_FILE"
    log "=================================================="
    exit "$rc"
}
trap finish EXIT

fail() {
    log "ERROR: $*"
    exit 1
}

# Check MongoDB Database Tools.
for cmd in mongodump mongorestore tee; do
    command -v "$cmd" >/dev/null 2>&1 ||
        fail "$cmd is not installed or is not in PATH."
done

log "MongoDB Backup and Restore started."
log "Backup directory: $BACKUP_DIR"
log "Log file: $LOG_FILE"

echo
echo "========== MONGODB BACKUP / RESTORE =========="
echo "1. Backup only"
echo "2. Restore only"
echo "3. Backup and restore"
echo "=============================================="

read -r -p "Select an option [1-3]: " ACTION

case "$ACTION" in
    1|2|3) ;;
    *) fail "Invalid menu option." ;;
esac

read -r -p "Enter database name: " DB_NAME
[[ -n "$DB_NAME" ]] || fail "Database name cannot be empty."
[[ "$DB_NAME" != *.* ]] ||
    fail "Enter a database name, not a namespace or collection name."

BACKUP_FILE="${BACKUP_DIR}/${DB_NAME}_${RUN_ID}.archive.gz"

# Read connection strings without displaying them on the console.
read_uri() {
    local prompt="$1"
    local variable="$2"
    local value

    read -r -s -p "$prompt" value
    echo
    [[ -n "$value" ]] || fail "MongoDB URI cannot be empty."
    printf -v "$variable" '%s' "$value"
}

# Execute a command, capture its output, and preserve its exit code.
run_logged() {
    "$@" 2>&1 | tee -a "$LOG_FILE"
    local rc=${PIPESTATUS[0]}
    return "$rc"
}

backup_database() {
    local source_uri="$1"

    log "STEP 1: Starting database backup."
    log "Database: $DB_NAME"
    log "Backup file: $BACKUP_FILE"
    log "Compression: gzip"

    if run_logged mongodump \
        --uri="$source_uri" \
        --db="$DB_NAME" \
        --archive="$BACKUP_FILE" \
        --gzip; then
        log "Backup completed successfully."
    else
        local rc=$?
        rm -f "$BACKUP_FILE"
        fail "mongodump failed with exit code $rc."
    fi

    [[ -s "$BACKUP_FILE" ]] ||
        fail "Backup archive is missing or empty."

    log "Backup size: $(du -h "$BACKUP_FILE" | awk '{print $1}')"
}

restore_database() {
    local target_uri="$1"
    local archive_file="$2"
    local drop_option="${3:-no}"

    [[ -s "$archive_file" ]] ||
        fail "Backup file not found or empty: $archive_file"

    log "STEP 2: Starting database restore."
    log "Database: $DB_NAME"
    log "Archive: $archive_file"
    log "Target database name will remain: $DB_NAME"

    local -a restore_args=(
        mongorestore
        "--uri=$target_uri"
        "--archive=$archive_file"
        "--gzip"
        "--nsInclude=${DB_NAME}.*"
    )

    if [[ "$drop_option" == "yes" ]]; then
        restore_args+=(--drop)
        log "WARNING: Existing target collections in this database"
        log "will be dropped before their corresponding collections are restored."
    else
        log "Existing target collections will not be dropped."
    fi

    if run_logged "${restore_args[@]}"; then
        log "Restore completed successfully."
    else
        local rc=$?
        fail "mongorestore failed with exit code $rc."
    fi
}

case "$ACTION" in
    1)
        read_uri "Enter SOURCE MongoDB URI: " SOURCE_URI
        backup_database "$SOURCE_URI"
        ;;

    2)
        read -r -p "Enter existing backup archive path: " BACKUP_FILE
        read_uri "Enter TARGET MongoDB URI: " TARGET_URI
        ;;

    3)
        read_uri "Enter SOURCE MongoDB URI: " SOURCE_URI
        read_uri "Enter TARGET MongoDB URI: " TARGET_URI
        backup_database "$SOURCE_URI"
        ;;
esac

if [[ "$ACTION" == "2" || "$ACTION" == "3" ]]; then
    echo
    read -r -p \
        "Drop existing target collections before restore? [y/N]: " DROP_ANSWER

    case "$DROP_ANSWER" in
        y|Y|yes|YES)
            DROP_OPTION="yes"
            ;;
        *)
            DROP_OPTION="no"
            ;;
    esac

    restore_database "$TARGET_URI" "$BACKUP_FILE" "$DROP_OPTION"
fi

log "All requested operations completed."
