SET NOCOUNT ON;

IF OBJECT_ID('tempdb..#QueryStoreInfo') IS NOT NULL
    DROP TABLE #QueryStoreInfo;

CREATE TABLE #QueryStoreInfo
(
    ServerName              SYSNAME,
    DatabaseName            SYSNAME,
    QueryStoreCurrentSize_MB DECIMAL(18,2),
    QueryStoreMaxSize_MB     DECIMAL(18,2),
    Actual_State             VARCHAR(30),
    Interval_Len_Min         INT,
    Threshold_Days           INT,
    EstimatedStartDate       DATETIME2(7)
);

DECLARE @SQL NVARCHAR(MAX) = N'';

SELECT @SQL = @SQL + N'
USE ' + QUOTENAME(name) + N';

IF EXISTS
(
    SELECT 1
    FROM sys.database_query_store_options
    WHERE actual_state_desc <> ''OFF''
)
BEGIN

    INSERT INTO #QueryStoreInfo
    (
        ServerName,
        DatabaseName,
        QueryStoreCurrentSize_MB,
        QueryStoreMaxSize_MB,
        Actual_State,
        Interval_Len_Min,
        Threshold_Days,
        EstimatedStartDate
    )
    SELECT
        @@SERVERNAME AS ServerName,
        DB_NAME() AS DatabaseName,

        CAST(qso.current_storage_size_mb AS DECIMAL(18,2))
            AS QueryStoreCurrentSize_MB,

        CAST(qso.max_storage_size_mb AS DECIMAL(18,2))
            AS QueryStoreMaxSize_MB,

        qso.actual_state_desc AS Actual_State,

        qso.interval_length_minutes AS Interval_Len_Min,

        qso.stale_query_threshold_days AS Threshold_Days,

        qs.EstimatedStartDate

    FROM sys.database_query_store_options AS qso

    CROSS JOIN
    (
        SELECT
            MIN(initial_compile_start_time) AS EstimatedStartDate
        FROM sys.query_store_query
    ) AS qs;

END;
'
FROM sys.databases
WHERE state_desc = 'ONLINE'
  AND database_id > 4;

EXEC sys.sp_executesql @SQL;

SELECT
    ServerName,
    DatabaseName,
    QueryStoreCurrentSize_MB,
    QueryStoreMaxSize_MB,
    Actual_State,
    Interval_Len_Min,
    Threshold_Days,
    EstimatedStartDate
FROM #QueryStoreInfo
ORDER BY DatabaseName;
