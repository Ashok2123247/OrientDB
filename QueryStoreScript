DECLARE @SQL NVARCHAR(MAX) = N'';

SELECT @SQL = @SQL + N'
USE ' + QUOTENAME(name) + N';

IF EXISTS
(
    SELECT 1
    FROM sys.database_query_store_options
    WHERE actual_state_desc <> ''OFF''
)
BEGIN
    SELECT
        @@SERVERNAME AS ServerName,
        DB_NAME() AS DatabaseName,

        CAST(qso.current_storage_size_mb AS DECIMAL(18,2))
            AS QueryStoreCurrentSize_MB,

        CAST(qso.max_storage_size_mb AS DECIMAL(18,2))
            AS QueryStoreMaxSize_MB,

        qso.actual_state_desc AS Actual_State,

        qso.interval_length_minutes AS Interval_Len_Min,

        qso.stale_query_threshold_days AS Threshold_Days,

        qs.EstimatedStartDate

    FROM sys.database_query_store_options qso

    CROSS JOIN
    (
        SELECT MIN(initial_compile_start_time) AS EstimatedStartDate
        FROM sys.query_store_query
    ) qs;
END;
'
FROM sys.databases
WHERE state_desc = 'ONLINE'
  AND database_id > 4;

EXEC sys.sp_executesql @SQL;





--If you want only databases where Query Store is currently enabled, use this:
DECLARE @SQL NVARCHAR(MAX) = N'';

SELECT @SQL = @SQL + N'
USE ' + QUOTENAME(name) + N';

IF EXISTS
(
    SELECT 1
    FROM sys.database_query_store_options
    WHERE actual_state_desc <> ''OFF''
)
BEGIN
    SELECT
        @@SERVERNAME AS ServerName,
        DB_NAME() AS DatabaseName,
        CAST(current_storage_size_mb AS DECIMAL(18,2))
            AS QueryStoreCurrentSize_MB,
        CAST(max_storage_size_mb AS DECIMAL(18,2))
            AS QueryStoreMaxSize_MB,
        actual_state_desc AS Actual_State,
        interval_length_minutes AS Interval_Len_Min,
        stale_query_threshold_days AS Threshold_Days,
        DATEADD(
            DAY,
            -stale_query_threshold_days,
            GETDATE()
        ) AS EstimatedStartDate
    FROM sys.database_query_store_options;
END;
'
FROM sys.databases
WHERE state_desc = 'ONLINE'
  AND database_id > 4;

EXEC sys.sp_executesql @SQL;
