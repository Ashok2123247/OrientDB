/* - Retrieves all indexes from the selected collection.
- Excludes the default _id index.
- Generates createIndex() commands.
- Preserves index names, unique, sparse, TTL, partial filter, and other index options.
- Generates a .js file that you can execute in the target environment.
Source environment – generate_indexes.js */


// Select database and collection
var dbName = "mydb";
var collectionName = "users";

var coll = db.getSiblingDB(dbName).getCollection(collectionName);

// Get all indexes
var indexes = coll.getIndexes();

// Output file content
print("// Index creation script");
print("use('" + dbName + "');");
print("");

indexes.forEach(function (index) {

    // Skip default _id index
    if (index.name == "_id_") {
        return;
    }

    var options = Object.assign({}, index);

    // Remove key and namespace-related fields
    delete options.v;
    delete options.key;
    delete options.ns;

    print(
        "db.getCollection('" + collectionName +
        "').createIndex(" +
        JSON.stringify(index.key) + ", " +
        JSON.stringify(options) +
        ");"
    );
});



//bash script
mongosh "mongodb://source-server:27017" --quiet generate_indexes.js > create_indexes.js


// execute only missing indexes in the target
var dbName = "mydb";
var collectionName = "users";

var targetColl = db.getSiblingDB(dbName)
                   .getCollection(collectionName);

var sourceIndexes = [
    { key: { email: 1 }, name: "email_1", unique: true },
    { key: { createdDate: -1 }, name: "createdDate_-1" }
];

var targetIndexes = targetColl.getIndexes();

sourceIndexes.forEach(function (srcIndex) {

    var exists = targetIndexes.some(function (tgtIndex) {
        return tgtIndex.name == srcIndex.name &&
               JSON.stringify(tgtIndex.key) ==
               JSON.stringify(srcIndex.key);
    });

    if (!exists) {
        var options = Object.assign({}, srcIndex);
        delete options.key;

        targetColl.createIndex(srcIndex.key, options);

        print("Created index: " + srcIndex.name);
    } else {
        print("Index already exists: " + srcIndex.name);
    }
});
