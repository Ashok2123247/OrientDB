# ============================================
# SQL Agent Job Command Export
# Does NOT use Invoke-Sqlcmd or sqlcmd
# ============================================

$SqlServer = "YOUR-SQL-SERVER"
$Database  = "msdb"

$SqlFile   = "C:\Scripts\Get-SQLAgentJobs.sql"
$OutputFile = "C:\Scripts\SQLAgentJobs_Output.txt"

# ------------------------------------------------
# Read T-SQL script
# ------------------------------------------------

$SqlQuery = Get-Content -Path $SqlFile -Raw

# ------------------------------------------------
# SQL Connection
# ------------------------------------------------

$ConnectionString = "Server=$SqlServer;Database=$Database;Integrated Security=True;TrustServerCertificate=True;"

$Connection = New-Object System.Data.SqlClient.SqlConnection
$Connection.ConnectionString = $ConnectionString

$Command = $Connection.CreateCommand()
$Command.CommandText = $SqlQuery
$Command.CommandTimeout = 0

# ------------------------------------------------
# Execute query
# ------------------------------------------------

try {

    $Connection.Open()

    $Reader = $Command.ExecuteReader()

    $Output = New-Object System.Text.StringBuilder

    # Header
    [void]$Output.AppendLine("============================================================")
    [void]$Output.AppendLine(" SQL SERVER AGENT JOB COMMAND REPORT")
    [void]$Output.AppendLine(" Server : $SqlServer")
    [void]$Output.AppendLine(" Date   : $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')")
    [void]$Output.AppendLine("============================================================")
    [void]$Output.AppendLine("")

    while ($Reader.Read()) {

        $JobName  = $Reader["JobName"].ToString()
        $StepName = $Reader["StepName"].ToString()
        $CommandText = $Reader["Command"].ToString()

        [void]$Output.AppendLine("------------------------------------------------------------")
        [void]$Output.AppendLine("JOB NAME : $JobName")
        [void]$Output.AppendLine("STEP     : $StepName")
        [void]$Output.AppendLine("------------------------------------------------------------")
        [void]$Output.AppendLine("")
        [void]$Output.AppendLine("COMMAND:")
        [void]$Output.AppendLine("")

        # Preserve original SQL formatting
        [void]$Output.AppendLine($CommandText.Trim())

        [void]$Output.AppendLine("")
        [void]$Output.AppendLine("")
    }

    $Reader.Close()

    # Write output
    $Output.ToString() | Set-Content -Path $OutputFile -Encoding UTF8

    Write-Host ""
    Write-Host "Report generated successfully:" -ForegroundColor Green
    Write-Host $OutputFile -ForegroundColor Yellow
    Write-Host ""

}
catch {

    Write-Host ""
    Write-Host "ERROR:" -ForegroundColor Red
    Write-Host $_.Exception.Message -ForegroundColor Red
}
finally {

    if ($Connection.State -eq "Open") {
        $Connection.Close()
    }

    $Connection.Dispose()
}










$SqlServer = "YOUR-SQL-SERVER"
$OutputFile = "C:\Scripts\SQLAgentJobs_Output.txt"

$SqlQuery = @"
SELECT
    j.name AS JobName,
    js.step_name AS StepName,
    js.command AS Command
FROM msdb.dbo.sysjobs AS j
INNER JOIN msdb.dbo.sysjobsteps AS js
    ON j.job_id = js.job_id
WHERE j.enabled = 1
ORDER BY
    j.name,
    js.step_id;
"@

$ConnectionString = "Server=$SqlServer;Database=msdb;Integrated Security=True;TrustServerCertificate=True;"

$Connection = New-Object System.Data.SqlClient.SqlConnection
$Connection.ConnectionString = $ConnectionString

$Command = $Connection.CreateCommand()
$Command.CommandText = $SqlQuery
$Command.CommandTimeout = 0

try {

    $Connection.Open()

    $Reader = $Command.ExecuteReader()

    $Output = New-Object System.Text.StringBuilder

    [void]$Output.AppendLine("============================================================")
    [void]$Output.AppendLine(" SQL SERVER AGENT JOB COMMAND REPORT")
    [void]$Output.AppendLine(" Server : $SqlServer")
    [void]$Output.AppendLine(" Date   : $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')")
    [void]$Output.AppendLine("============================================================")
    [void]$Output.AppendLine("")

    while ($Reader.Read()) {

        [void]$Output.AppendLine("------------------------------------------------------------")
        [void]$Output.AppendLine("JOB NAME : " + $Reader["JobName"])
        [void]$Output.AppendLine("STEP     : " + $Reader["StepName"])
        [void]$Output.AppendLine("------------------------------------------------------------")
        [void]$Output.AppendLine("")
        [void]$Output.AppendLine("COMMAND:")
        [void]$Output.AppendLine("")
        [void]$Output.AppendLine($Reader["Command"].ToString().Trim())
        [void]$Output.AppendLine("")
        [void]$Output.AppendLine("")
    }

    $Reader.Close()

    $Output.ToString() | Set-Content $OutputFile -Encoding UTF8

    Write-Host "Output created: $OutputFile" -ForegroundColor Green

}
finally {

    if ($Connection.State -eq "Open") {
        $Connection.Close()
    }

    $Connection.Dispose()
}
